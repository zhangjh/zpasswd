{"dependencies": {"hono": "^4.7.0", "jose": "^6.1.0"}, "description": "zpasswd 同步服务：Cloudflare Workers + Hono + D1。哑管道，只存密文，永远不接触明文。", "devDependencies": {"@cloudflare/workers-types": "^4.20250101.0", "typescript": "^5.7.2", "wrangler": "^4.0.0"}, "name": "@pm/server", "private": true, "scripts": {"build": "tsc -p tsconfig.json", "db:create": "wrangler d1 create zpasswd", "db:migrate": "wrangler d1 migrations apply zpasswd --remote", "db:migrate:local": "wrangler d1 migrations apply zpasswd --local", "deploy": "wrangler deploy", "dev": "wrangler dev"}, "type": "module", "version": "0.1.0"}