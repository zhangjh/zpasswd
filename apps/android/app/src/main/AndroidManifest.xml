<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- 保存凭证提醒通知（Android 13+ 需运行时申请） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-feature android:name="android.hardware.fingerprint" android:required="false" />

    <!--
      Android 11+ 包可见性：自动填充需要读取「目标应用名称」，才能把网页 URL 存下来的
      条目匹配到原生 App（如 com.tencent.mm ↔ 微信）。自动填充服务不在系统自动可见豁免
      名单内（只有 IME 在），必须显式声明。
      这里只声明带 LAUNCHER 的应用，不使用 QUERY_ALL_PACKAGES，符合 Play 政策。
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".ZpasswdApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="zpasswd"
        android:theme="@style/Theme.Zpasswd"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 解锁页：Autofill 认证流程跳转到此（不导出，系统经 PendingIntent 调用） -->
        <activity
            android:name=".ui.UnlockActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- 自动填充服务 -->
        <service
            android:name=".autofill.ZpasswdAutofillService"
            android:exported="true"
            android:permission="android.permission.BIND_AUTOFILL_SERVICE">
            <intent-filter>
                <action android:name="android.service.autofill.AutofillService" />
            </intent-filter>
            <meta-data
                android:name="android.autofill"
                android:resource="@xml/autofill_service_config" />
        </service>

        <!--
          浏览器自动填充（无障碍服务）。

          必须存在的理由：移动端 Chromium（Chrome / Edge / 各家内核浏览器）不会把网页里的
          密码框通过 AssistStructure 交给自动填充服务。实测 Edge 153 在 HTTPS 登录页上
          连一个 FillRequest 都不发；小米浏览器只交出地址栏。所有密码管理器
          （Bitwarden / 1Password / Dashlane）都因此额外提供无障碍服务，
          直接读取无障碍节点树来识别并填充网页登录框。
        -->
        <service
            android:name=".autofill.ZpasswdAccessibilityService"
            android:exported="true"
            android:label="zpasswd 浏览器填充"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

    </application>
</manifest>
